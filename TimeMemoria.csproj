<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <!-- MAJOR.MINOR.PATCH.API. The fourth digit is the Dalamud API level, so
         a build says which game version it targets without anyone opening the
         manifest. Safe for Dalamud's monotonic-version rule because the API
         level only ever climbs.

         Releases at 3.0.0.15. Nothing before it was published, but two earlier
         versions were built and flown, and this one is shaped by what they
         taught: v2 maintained its quest data by hand and stalled on a patch,
         which is why this reads from the game's own tables. Starting at 1.0
         would hide the reason it works the way it does. -->
    <Version>3.10.1.15</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Stays TimeMemoriaV3 permanently. Dalamud derives InternalName from this,
         and InternalName is what keys the config file and the directory holding
         the quest journal and snapshot. Renaming it would orphan both — and
         would collide with the earlier attempt's own config, which is still on
         disk. Nothing is gained: the name below is what anyone actually sees. -->
    <AssemblyName>TimeMemoriaV3</AssemblyName>
    <RootNamespace>TimeMemoria</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Author>Legends of the Game</Author>
    <Name>Tales of Milestones</Name>
    <Punchline>Remember every step, Warriors of Light.</Punchline>
    <Description>Quest progression and pacing — a reflective notebook for your story journey, not a scoreboard.</Description>
    <RepoUrl>https://github.com/LegendsOfTheGame/TimeMemoriaV3</RepoUrl>
    <Tags>quest;quests;progression;pacing;tracker</Tags>
    <!-- Here, not only in tools/Build-RepoJson.py: the official repository
         builds the manifest from these properties and never runs that script. -->
    <CategoryTags>utility</CategoryTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hand-derived patch gates, shipped beside the assembly. -->
    <None Include="data/toc.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Festival names, which the game's own sheet leaves blank. -->
    <None Include="data/festival-names.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Which patch introduced each quest. Not in the game files at all. -->
    <None Include="data/quest-patches.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Where each Beastmaster beast is tamed. Copied from Bestiary Mapper. -->
    <None Include="data/bestiary.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The submodule lives inside this project's directory, so the SDK's default
       globbing would compile its sources into this assembly as well as
       referencing them. Exclude the folder and let the project reference do it. -->
  <ItemGroup>
    <Compile Remove="lib/**" />
    <None Remove="lib/**" />
    <EmbeddedResource Remove="lib/**" />
    <Content Remove="lib/**" />
  </ItemGroup>

  <!-- tools/SheetProbe is its own project. The default glob only excludes this
       project's own obj/bin, not a nested project's, so once SheetProbe has
       been built its generated AssemblyInfo.cs gets swept into this assembly
       too and collides with TimeMemoria's own. -->
  <ItemGroup>
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
    <EmbeddedResource Remove="tools/**" />
    <Content Remove="tools/**" />
  </ItemGroup>

  <!-- Native FFXIV UI. Consumed as a submodule because it is not published as a
       package. After cloning, initialise submodules before building.

       No Private="True" here. Set explicitly, it made MSBuild copy every
       Dalamud dependency KamiToolKit touches (Dalamud.Common, Iced, Reloaded,
       SQLite-net and ~20 more) out of Hooks/dev into the release zip. Dalamud
       already loads those; VanillaPlus and DailyDuty reference KTK the same
       way. Found 27 Oct 2026. -->
  <ItemGroup>
    <ProjectReference Include="lib/KamiToolKit/KamiToolKit.csproj" />
    <ProjectReference Include="lib/KamiToolKit.Components/KamiToolKit.Components.csproj" />
  </ItemGroup>
</Project>
