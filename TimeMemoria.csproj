<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <!-- Releases at 3.0.0.0. Nothing before it was published, but two earlier
         versions were built and flown, and this one is shaped by what they
         taught: v2 maintained its quest data by hand and stalled on a patch,
         which is why this reads from the game's own tables. Starting at 1.0
         would hide the reason it works the way it does. -->
    <Version>0.1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Distinct assembly name only so the earlier attempt can stay installed
         alongside this one while its numbers are still worth comparing against.
         Nobody else has either plugin, so this is a one-line change to
         TimeMemoria whenever that stops being useful. -->
    <AssemblyName>TimeMemoriaV3</AssemblyName>
    <RootNamespace>TimeMemoria</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Author>Legends of the Game</Author>
    <Name>Time Memoria (Rebuild)</Name>
    <Punchline>Remember every step, Warriors of Light.</Punchline>
    <Description>Quest progression and pacing — a reflective notebook for your story journey, not a scoreboard.</Description>
    <RepoUrl>https://github.com/LegendsOfTheGame/TimeMemoriaV3</RepoUrl>
    <Tags>quest;quests;progression;pacing;tracker</Tags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hand-derived patch gates, shipped beside the assembly. -->
    <None Include="data/toc.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Festival names, which the game's own sheet leaves blank. -->
    <None Include="data/festival-names.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The submodule lives inside this project's directory, so the SDK's default
       globbing would compile its sources into this assembly as well as
       referencing them. Exclude the folder and let the project reference do it. -->
  <ItemGroup>
    <Compile Remove="lib/**" />
    <None Remove="lib/**" />
    <EmbeddedResource Remove="lib/**" />
    <Content Remove="lib/**" />
  </ItemGroup>

  <!-- Native FFXIV UI. Consumed as a submodule because it is not published as a
       package. After cloning, initialise submodules before building. -->
  <ItemGroup>
    <ProjectReference Include="lib/KamiToolKit/KamiToolKit.csproj" Private="True" />
  </ItemGroup>
</Project>
